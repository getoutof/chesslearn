# Скопируйте в tool/remote.env (не коммитится) и поправьте.
REMOTE_HOST=127.0.0.1
REMOTE_PORT=2224
REMOTE_USER=chessbuild
# Папка проекта на билд-машине, относительно её $HOME.
REMOTE_DIR=chesslearn
# Файл на билд-машине, который добавляет flutter/java/android-sdk в PATH.
REMOTE_ENV='$HOME/chessbuild.env'
